<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/">
    <file alias="styles.qss">styles.qss</file>
    <file alias="icon.png">images/icon_transparent_256.png</file>

    <!-- Arrows -->
    <file alias="arrow-right.svg">images/arrows/arrow-right.svg</file>
    <file alias="arrow-down.svg">images/arrows/arrow-down.svg</file>

    <!-- Trash -->
    <file alias="trash.svg">images/icons/trash.svg</file>
    <file alias="trash-dark.svg">images/icons/trash-dark.svg</file>
    <file alias="trash-light.svg">images/icons/trash-light.svg</file>

    <!-- Settings -->
    <file alias="settings-light.svg">images/icons/settings-light.svg</file>
    <file alias="settings-dark.svg">images/icons/settings-dark.svg</file>

    <!-- Expand/Collapse -->
    <file alias="expand-all-dark.svg">images/icons/expand-all-dark.svg</file>
    <file alias="expand-all-light.svg">images/icons/expand-all-light.svg</file>
    <file alias="collapse-all-dark.svg">images/icons/collapse-all-dark.svg</file>
    <file alias="collapse-all-light.svg">images/icons/collapse-all-light.svg</file>

    <!-- Dock controls -->
    <file alias="close-dark.svg">images/icons/close-dark.svg</file>
    <file alias="close-light.svg">images/icons/close-light.svg</file>
    <file alias="float-dark.svg">images/icons/float-dark.svg</file>
    <file alias="float-light.svg">images/icons/float-light.svg</file>

    <!-- Splitter grip -->
    <file alias="splitter-grip-dark.svg">images/icons/splitter-grip-dark.svg</file>
    <file alias="splitter-grip-light.svg">images/icons/splitter-grip-light.svg</file>

    <!-- Avrile Sans (OTF) -->
    <file alias="fonts/AvrileSans-Thin.otf">fonts/avrile-sans/AvrileSans-Thin.otf</file>
    <file alias="fonts/AvrileSans-ThinItalic.otf">fonts/avrile-sans/AvrileSans-ThinItalic.otf</file>
    <file alias="fonts/AvrileSans-ExtraLight.otf">fonts/avrile-sans/AvrileSans-ExtraLight.otf</file>
    <file alias="fonts/AvrileSans-ExtraLightItalic.otf">fonts/avrile-sans/AvrileSans-ExtraLightItalic.otf</file>
    <file alias="fonts/AvrileSans-Light.otf">fonts/avrile-sans/AvrileSans-Light.otf</file>
    <file alias="fonts/AvrileSans-LightItalic.otf">fonts/avrile-sans/AvrileSans-LightItalic.otf</file>
    <file alias="fonts/AvrileSans-Regular.otf">fonts/avrile-sans/AvrileSans-Regular.otf</file>
    <file alias="fonts/AvrileSans-Italic.otf">fonts/avrile-sans/AvrileSans-Italic.otf</file>
    <file alias="fonts/AvrileSans-Medium.otf">fonts/avrile-sans/AvrileSans-Medium.otf</file>
    <file alias="fonts/AvrileSans-MediumItalic.otf">fonts/avrile-sans/AvrileSans-MediumItalic.otf</file>
    <file alias="fonts/AvrileSans-SemiBold.otf">fonts/avrile-sans/AvrileSans-SemiBold.otf</file>
    <file alias="fonts/AvrileSans-SemiBoldItalic.otf">fonts/avrile-sans/AvrileSans-SemiBoldItalic.otf</file>
    <file alias="fonts/AvrileSans-Bold.otf">fonts/avrile-sans/AvrileSans-Bold.otf</file>
    <file alias="fonts/AvrileSans-BoldItalic.otf">fonts/avrile-sans/AvrileSans-BoldItalic.otf</file>
    <file alias="fonts/AvrileSans-ExtraBold.otf">fonts/avrile-sans/AvrileSans-ExtraBold.otf</file>
    <file alias="fonts/AvrileSans-ExtraBoldItalic.otf">fonts/avrile-sans/AvrileSans-ExtraBoldItalic.otf</file>
    <file alias="fonts/AvrileSans-Black.otf">fonts/avrile-sans/AvrileSans-Black.otf</file>
    <file alias="fonts/AvrileSans-BlackItalic.otf">fonts/avrile-sans/AvrileSans-BlackItalic.otf</file>

    <!-- Avrile Serif (OTF) -->
    <file alias="fonts/AvrileSerif-Thin.otf">fonts/avrile-serif/AvrileSerif-Thin.otf</file>
    <file alias="fonts/AvrileSerif-ThinItalic.otf">fonts/avrile-serif/AvrileSerif-ThinItalic.otf</file>
    <file alias="fonts/AvrileSerif-ExtraLight.otf">fonts/avrile-serif/AvrileSerif-ExtraLight.otf</file>
    <file alias="fonts/AvrileSerif-ExtraLightItalic.otf">fonts/avrile-serif/AvrileSerif-ExtraLightItalic.otf</file>
