    <file alias="fonts/AvrileSerif-LightItalic.otf">fonts/avrile-serif/AvrileSerif-LightItalic.otf</file>
    <file alias="fonts/AvrileSerif-Regular.otf">fonts/avrile-serif/AvrileSerif-Regular.otf</file>
    <file alias="fonts/AvrileSerif-Italic.otf">fonts/avrile-serif/AvrileSerif-Italic.otf</file>
    <file alias="fonts/AvrileSerif-Medium.otf">fonts/avrile-serif/AvrileSerif-Medium.otf</file>
    <file alias="fonts/AvrileSerif-MediumItalic.otf">fonts/avrile-serif/AvrileSerif-MediumItalic.otf</file>
    <file alias="fonts/AvrileSerif-SemiBold.otf">fonts/avrile-serif/AvrileSerif-SemiBold.otf</file>
    <file alias="fonts/AvrileSerif-SemiBoldItalic.otf">fonts/avrile-serif/AvrileSerif-SemiBoldItalic.otf</file>
    <file alias="fonts/AvrileSerif-Bold.otf">fonts/avrile-serif/AvrileSerif-Bold.otf</file>
    <file alias="fonts/AvrileSerif-BoldItalic.otf">fonts/avrile-serif/AvrileSerif-BoldItalic.otf</file>
    <file alias="fonts/AvrileSerif-ExtraBold.otf">fonts/avrile-serif/AvrileSerif-ExtraBold.otf</file>
    <file alias="fonts/AvrileSerif-ExtraBoldItalic.otf">fonts/avrile-serif/AvrileSerif-ExtraBoldItalic.otf</file>
    <file alias="fonts/AvrileSerif-Black.otf">fonts/avrile-serif/AvrileSerif-Black.otf</file>
    <file alias="fonts/AvrileSerif-BlackItalic.otf">fonts/avrile-serif/AvrileSerif-BlackItalic.otf</file>

    <!-- Droid Serif -->
    <file alias="fonts/DroidSerif.ttf">fonts/droid-serif/DroidSerif.ttf</file>
    <file alias="fonts/DroidSerif-Italic.ttf">fonts/droid-serif/DroidSerif-Italic.ttf</file>
    <file alias="fonts/DroidSerif-Bold.ttf">fonts/droid-serif/DroidSerif-Bold.ttf</file>
    <file alias="fonts/DroidSerif-BoldItalic.ttf">fonts/droid-serif/DroidSerif-BoldItalic.ttf</file>

    <!-- High Sans Serif 7 -->
    <file alias="fonts/high_sans_serif_7.ttf">fonts/high-sans-serif-7/high_sans_serif_7.ttf</file>

    <!-- Open Sans Condensed -->
    <file alias="fonts/OpenSans-CondLight.ttf">fonts/open-sans-condensed/OpenSans-CondLight.ttf</file>
    <file alias="fonts/OpenSans-CondLightItalic.ttf">fonts/open-sans-condensed/OpenSans-CondLightItalic.ttf</file>
    <file alias="fonts/OpenSans-CondBold.ttf">fonts/open-sans-condensed/OpenSans-CondBold.ttf</file>

    <!-- Fira Code iScript (monospace) -->
    <file alias="fonts/FiraCodeiScript-Regular.ttf">fonts/FireCodeiScript/FiraCodeiScript-Regular.ttf</file>
    <file alias="fonts/FiraCodeiScript-Italic.ttf">fonts/FireCodeiScript/FiraCodeiScript-Italic.ttf</file>
    <file alias="fonts/FiraCodeiScript-Bold.ttf">fonts/FireCodeiScript/FiraCodeiScript-Bold.ttf</file>

    <!-- Yoster Island -->
    <file alias="fonts/yoster.ttf">fonts/yoster-island/yoster.ttf</file>

    <!-- RM Typerighter -->
    <file alias="fonts/rm_typerighter.ttf">fonts/rm-typerighter/rm_typerighter.ttf</file>
